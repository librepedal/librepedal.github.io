rules_version = '2';

// ============================================================================
// REGLAS DE SEGURIDAD DE FIRESTORE — Libre Pedal
// Lectura pública (la comunidad se ve siempre). Escritura SOLO autenticada, con
// límites de tamaño para evitar abuso y "bombas" de datos, y verificación de
// dueño real donde corresponde (ver isOwnerOrLegacy / isAdmin más abajo).
//
// AUTH (actualizado 2026-07-12): la app arranca con Auth ANÓNIMA (uid aleatorio,
// para no bloquear a nadie apenas abre la app), pero apenas se conoce tu `cu`
// (login o registro) la sube a un token personalizado de Firebase — emitido por
// el Worker `librepedal-auth` — que fija tu uid de Firebase Auth a tu `cu` real,
// ESTABLE en cualquier dispositivo. Con eso, `request.auth.uid` puede compararse
// directo contra el campo `user` que YA se guarda en cada documento desde
// siempre — protege también los documentos viejos, sin tener que re-escribir
// nada. Si el Worker de tokens no responde (sin señal, caído), la app sigue con
// la sesión anónima de siempre — no se rompe el login, solo queda con protección
// parcial hasta que pueda re-intentar. Detalle completo en
// COORDINACION-IA/BITACORA.md, entrada 2026-07-12.
//
// CÓMO PUBLICAR CAMBIOS A ESTE ARCHIVO (en orden, importante):
//   1) Firebase Console -> Firestore Database -> pestaña Reglas -> pega esto -> Publicar.
//   2) Si tocaste algo admin-only (novedades/retos/frasesComunidad), recarga la
//      app UNA vez antes de usar el panel de admin — así tu sesión sube al
//      token personalizado y `isAdmin()` te reconoce.
//   Si algo se rompe, vuelve a las reglas abiertas temporalmente.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Auditoría 2026-09-09: signedIn() también es true en la sesión anónima con la
    // que arranca la app (ver nota de arriba) -- eso dejaba CASI TODAS las colecciones
    // abiertas a escritura sin que nadie se registrara ni entrara con código de tester,
    // simplemente abriendo la app y llamando la API directo (spam masivo / DoW por
    // escrituras). signedInReal() exige además que la sesión NO sea anónima -- se usa
    // en los `create` (el punto donde se generan documentos nuevos) de las colecciones
    // públicas/comunitarias. Los `update`/`delete` ya protegidos por dueño real
    // (isOwnerOrLegacy/isOwnerByCu) no se tocan: un anónimo no puede satisfacerlos igual.
    function signedInReal() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // true si el campo no viene, o si es string y no supera n caracteres
    function strOk(f, n) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is string && request.resource.data[f].size() <= n);
    }
    // Dueño real. Dos vías, la primera es la buena y cubre TODO (documentos
    // viejos y nuevos) para quien ya se autenticó con el token personalizado:
    //  1) isOwnerByCu(): el campo `user` del documento (tu `cu`, se guarda desde
    //     siempre) coincide con tu uid de Firebase Auth de hoy.
    //  2) authUid == uid, con grandfather si el campo ni existe: respaldo para
    //     mientras el usuario sigue en la sesión anónima vieja (no se rompe nada
    //     hasta que recargue y su auth suba sola al token personalizado).
    function isOwnerByCu() {
      return 'user' in resource.data && resource.data.user == request.auth.uid;
    }
    function isOwnerOrLegacy() {
      return isOwnerByCu()
        || !('authUid' in resource.data) || resource.data.authUid == request.auth.uid;
    }
    // Admin real: tu `cu` (correo transformado) es literalmente el uid de Firebase
    // Auth una vez que tu sesión subió al token personalizado — antes de eso
    // (sesión anónima vieja, sin recargar) esto da false, ver nota de arriba.
    function isAdmin() {
      return request.auth.uid == 'intyrivera_a_gmail_com';
    }

    // `premium` (2026-09-04): estado de suscripcion paga, escrito SOLO por el
    // worker de verificacion de compras via Admin SDK (que no pasa por estas
    // reglas -- por eso alcanza con bloquear al CLIENTE). Sin esto, cualquier
    // usuario se haria premium gratis con un `update({premium:{activo:true}})`
    // desde la consola del navegador -- mismo patron de hallazgo que el resto
    // de la auditoria de este proyecto (ver liveTracking, commit 9387ca9).
    function premiumSinTocar() {
      return !('premium' in request.resource.data)
        || ('premium' in resource.data && request.resource.data.premium == resource.data.premium);
    }

    // Auditoría 2026-09-16 (control de calidad estructural, tras el 4to rechazo de
    // Play Store por el mismo patrón: arreglar el caso reportado sin cazar la CLASE
    // completa del bug). Helpers genéricos para cerrar 2 clases de hallazgo que se
    // repetían colección por colección:
    //
    // 1) IMPERSONACIÓN: ninguna colección validaba que el autor (user/authUid/
    //    creadoPor/from) fuera de verdad quien está escribiendo -- un ciclista podía
    //    crear una ruta o un reporte con el `user` de OTRO, y aparecía en el perfil
    //    público de la víctima como si ella lo hubiera hecho. Confirmado contra el
    //    código real (grep de cada `.add(...)`) que TODAS las colecciones de abajo ya
    //    escriben su propio uid en esos campos hoy -- este helper no exige que el
    //    campo esté (cada colección usa el suyo, y `guiComments` tiene 2 formas de
    //    documento distintas), solo que SI está, coincida con quien firma la escritura.
    //    Por eso no rompe ninguna escritura legítima existente.
    function autorEsUnoMismo() {
      return (!('user' in request.resource.data) || request.resource.data.user == request.auth.uid)
        && (!('authUid' in request.resource.data) || request.resource.data.authUid == request.auth.uid)
        && (!('creadoPor' in request.resource.data) || request.resource.data.creadoPor == request.auth.uid)
        && (!('from' in request.resource.data) || request.resource.data.from == request.auth.uid);
    }
    // 2) VALORES SIN LÍMITE: Darma/km/tiempos de segmento aceptaban cualquier número,
    //    incluido escribir 999999999 directo desde la consola del navegador (el JS de
    //    esta app se sirve en vivo y es 100% visible/editable por el cliente, así que
    //    las reglas son la ÚNICA defensa real). numOk() es para valores acotados en un
    //    rango fijo (ej. un tiempo de segmento); statsIncrementoPlausible() es para
    //    contadores que crecen con el uso normal (Darma, km) -- no puede evitar del
    //    todo la trampa (no hay Cloud Function que recalcule desde el GPS crudo, eso
    //    queda como hallazgo pendiente aparte), pero hace IMPOSIBLE saltar de 0 a
    //    999999999 de un tiro, que es el ataque real que se probó en la auditoría.
    function numOk(f, min, max) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is number && request.resource.data[f] >= min && request.resource.data[f] <= max);
    }
    function statsIncrementoPlausible(campo, maxDelta) {
      return !(campo in request.resource.data) || !(campo in resource.data)
        || (request.resource.data[campo] is number && resource.data[campo] is number
            && request.resource.data[campo] - resource.data[campo] <= maxDelta
            && request.resource.data[campo] - resource.data[campo] >= -maxDelta);
    }
    // createdAt decide el cupo de "Socio Fundador" (primeros 3 meses) -- sin esto,
    // cualquiera podía reescribir su propia fecha de registro a una vieja y
    // autodeclararse fundador gratis.
    function createdAtSinTocar() {
      return !('createdAt' in request.resource.data) || !('createdAt' in resource.data)
        || request.resource.data.createdAt == resource.data.createdAt;
    }

    // Perfiles de ciclistas. update restringido al dueño real: antes cualquier
    // usuario autenticado podía sobrescribir el perfil de OTRO (nombre, casco,
    // skin) con solo saber su `cu`.
    match /users/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('nombre', 60) && strOk('email', 120) && strOk('helmet', 40) && strOk('skin', 30) && strOk('bio', 300) && !('premium' in request.resource.data);
      allow update: if signedIn() && strOk('nombre', 60) && strOk('email', 120) && strOk('helmet', 40) && strOk('skin', 30) && strOk('bio', 300) && isOwnerOrLegacy() && premiumSinTocar()
        && statsIncrementoPlausible('darma', 300) && statsIncrementoPlausible('km', 300) && createdAtSinTocar();
      allow delete: if false;
    }

    // Amistades confirmadas (2026-08-14): espejo de friendRequests con id
    // DETERMINISTA (uidMenor_uidMayor) para poder chequear "son amigos" desde otra
    // regla con exists(), sin poder hacer queries dentro de una regla. Se crea SOLO
    // al aceptar una solicitud (acceptFriendRequest en index.html). Nadie la lee
    // directo -- solo la usa sonAmigos() desde perfilPrivado.
    function sonAmigos(otroId) {
      let par = request.auth.uid < otroId ? request.auth.uid + '_' + otroId : otroId + '_' + request.auth.uid;
      return exists(/databases/$(database)/documents/amistades/$(par));
    }
    match /amistades/{id} {
      allow read: if false;
      allow create: if signedInReal()
        && (request.auth.uid == request.resource.data.a || request.auth.uid == request.resource.data.b)
        && request.resource.data.a < request.resource.data.b
        && id == request.resource.data.a + '_' + request.resource.data.b;
      allow update, delete: if false;
    }

    // Perfil de comunidad PRIVADO (fotos + relatos, 2026-08-14): a diferencia de
    // /users (publico a proposito), esto solo lo ve el dueno o sus amigos
    // aceptados -- pedido explicito de Inty ("solo los amigos pueden ver cosas
    // privadas"). Limites de tamano para que no se pueda inflar el documento con
    // fotos infinitas (Firestore tiene tope de 1MB por documento).
    match /perfilPrivado/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin() || sonAmigos(id));
      allow create, update: if signedIn() && request.auth.uid == id
        && (!('fotos' in request.resource.data) || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 9))
        && (!('relatos' in request.resource.data) || (request.resource.data.relatos is list && request.resource.data.relatos.size() <= 30));
      allow delete: if false;
    }

    // Correo de cada usuario, SEPARADO del perfil público (2026-07-14): antes
    // vivía dentro de /users/{id}, que es de lectura pública a propósito (el
    // Ranking mundial y "ver perfil de otro ciclista" necesitan leer a TODOS
    // los usuarios) — eso significaba que cualquiera con la config pública de
    // Firebase (visible en el código del sitio, como en cualquier app web)
    // podía sacar el correo de TODA la comunidad sin ser admin ni estar
    // logueado, sin pasar por la app. El id del documento es el mismo `cu`
    // que usa /users/{id}. Solo el dueño (o el admin real, para el export en
    // CSV del panel) puede leerlo.
    match /usersPrivate/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());
      allow write: if signedIn() && request.auth.uid == id && strOk('email', 120);
    }

    // Analiticas de uso por usuario (2026-08-24): un doc por usuario (id=cu), que la
    // app va llenando solo con contadores propios (pantallas vistas, tiempo, funciones
    // usadas) via _flushAnalytics() en index.html. NUNCA tuvo regla -- caia al bloqueo
    // por defecto del final de este archivo, asi que ni se guardaba ni el panel admin
    // ("Analiticas de uso") podia leerla (permission-denied real, verificado en vivo).
    // Solo el dueno escribe su propio doc, solo el admin lee (agrega todos para el panel).
    match /usage/{id} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == id && strOk('nombre', 60);
      allow delete: if false;
    }

    // Contador de suscritos totales (para no leer TODA la colección `users` cada
    // vez que alguien abre Comunidad o intenta votar — con miles de usuarios eso
    // eran miles de lecturas por un solo clic). Solo un documento, se incrementa
    // en el registro. Cualquier signedIn() puede escribirlo (igual de confianza
    // que otros contadores comunitarios de la app, ej. likes) — no es dato
    // sensible, en el peor caso alguien lo infla y la votación se activa antes de
    // los 5.000 reales.
    match /meta/{id} {
      allow read: if true;
      allow create, update: if signedInReal();
      allow delete: if false;
    }

    // Chat global de la comunidad. Auditoría 2026-08-30: update/delete estaba
    // abierto a CUALQUIER signedIn() sin verificar dueño — cualquiera podía
    // editar o borrar el mensaje de otro llamando la API directo (a diferencia
    // de /reportes, /recommendations, /hostels, que sí documentan por qué su
    // update abierto es intencional). Acá no había razón documentada. OJO: este
    // documento guarda el autor en el campo `a` (no `user`/`authUid` como el
    // resto del archivo), así que isOwnerOrLegacy() NO sirve — su "grandfather"
    // (autoriza a cualquiera cuando falta `authUid`) habría dejado esto abierto
    // igual, sin arreglar nada. Se compara directo contra `a`.
    match /chat/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('t', 500) && strOk('nombre', 60);
      allow update, delete: if signedIn() && resource.data.a == request.auth.uid;
    }

    // Mapa comunitario "Reportar en Ruta". Nadie lo edita/borra salvo quien lo creó
    // (o cualquiera, en documentos de antes de este cambio — ver isOwnerOrLegacy).
    match /reportes/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('text', 600) && strOk('comuna', 80) && strOk('cat', 30) && autorEsUnoMismo();
      allow update, delete: if signedIn() && isOwnerOrLegacy();
      // Confirmación comunitaria estilo Waze (v6.86): CUALQUIER usuario logueado puede
      // decir "sigue ahí" / "ya no está", pero SOLO tocando los campos de confirmación —
      // no puede alterar el texto, la categoría ni la ubicación del reporte de otro.
      // Sin esto, los botones 👍/🚫 fallan en silencio para todos menos el autor.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['confirmadoPor', 'desmentidoPor', 'lastConfirm']);
    }

    // Alertas de ruta
    match /routeAlerts/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('desc', 500) && strOk('type', 60);
      allow update, delete: if signedIn();
    }

    // Comentarios de la CicloGuía
    match /guiComments/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('text', 500) && autorEsUnoMismo();
      allow update, delete: if signedIn() && isOwnerOrLegacy();
    }

    // Recomendaciones. update queda abierto a signedIn(): "me gusta" (likes/likedBy)
    // lo actualiza CUALQUIER usuario, no solo el dueño — es el comportamiento real
    // de la función. delete sí se restringe: nadie borra la recomendación de otro.
    match /recommendations/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('title', 120) && strOk('desc', 800) && autorEsUnoMismo();
      allow update: if signedIn() && strOk('title', 120) && strOk('desc', 800);
      allow delete: if signedIn() && isOwnerOrLegacy();
    }

    // Hospedajes / campings. update queda abierto: las calificaciones (estrellas)
    // las pone cualquier usuario, no solo el dueño. delete sí se restringe.
    match /hostels/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('name', 120) && strOk('location', 200) && strOk('desc', 800) && autorEsUnoMismo();
      allow update: if signedIn();
      allow delete: if signedIn() && isOwnerOrLegacy();
    }

    // Tips de taller (MacGyver)
    match /repairTips/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('title', 120) && strOk('desc', 1000) && autorEsUnoMismo();
      allow update, delete: if signedIn() && isOwnerOrLegacy();
    }

    // Rutas grabadas (públicas). update/delete permitidos: la app actualiza la
    // misma ruta mientras la vas grabando (checkpoints) y el usuario puede borrar
    // las suyas desde "Mis Rutas" — con "if false" ninguna de las dos cosas
    // funcionaba de verdad (la app lo ocultaba con un catch silencioso). Restringido
    // al dueño real: nadie más tiene por qué tocar tu ruta grabada.
    match /routes/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('hospedaje', 200) && strOk('notasDelDia', 3000) && autorEsUnoMismo();
      allow update, delete: if signedIn() && isOwnerOrLegacy() && strOk('hospedaje', 200) && strOk('notasDelDia', 3000);
    }

    // Track GPS completo (sin difuminar) de una ruta. Auditoría 2026-08-30: /routes
    // era pública Y guardaba el track exacto sin redondear — cualquiera que supiera
    // tu correo podía descargar tu historial GPS completo (domicilio/trabajo
    // inferibles). Pero /routes también alimenta una función real de la app
    // ("Rutas para ti": recomienda y muestra en el mapa rutas de otros ciclistas
    // cercanos), así que cerrarla del todo mataba esa función. Solución elegida por
    // Inty: /routes se queda pública pero ahora solo guarda `pointsPub` (recorta el
    // inicio/fin y redondea coordenadas — ver _puntosPublicos() en index.html); el
    // track EXACTO vive acá, separado, solo para el dueño real.
    match /routesTrack/{id} {
      allow read: if signedIn() && isOwnerOrLegacy();
      allow create: if signedInReal() && request.resource.data.user == request.auth.uid;
      allow update: if signedIn() && isOwnerOrLegacy();
      allow delete: if signedIn() && isOwnerOrLegacy();
    }

    // Viajes planificados (el usuario gestiona los suyos desde la app)
    match /trips/{id} {
      allow read: if true;
      allow create: if signedInReal() && autorEsUnoMismo();
      // gpsData.distance lo escribe el cliente al terminar el viaje (finishTrip/
      // finishTripAuto) -- sin límite, un viaje con "500.000 km" era válido para las
      // reglas. Tope generoso (1.000 km) para no chocar con ultra-distancia real.
      allow update, delete: if signedIn() && isOwnerOrLegacy()
        && (!('gpsData' in request.resource.data) || !('distance' in request.resource.data.gpsData)
            || (request.resource.data.gpsData.distance is number
                && request.resource.data.gpsData.distance >= 0
                && request.resource.data.gpsData.distance <= 1000));
    }

    // Solicitudes de amistad. update queda abierto: quien las ACEPTA/RECHAZA es el
    // destinatario, no quien las creó — restringirlo a isOwnerOrLegacy rompería esa
    // función. delete sí se restringe al que la envió (hoy la app no borra
    // solicitudes, pero si algo llega a hacerlo, que sea solo el propio remitente).
    match /friendRequests/{id} {
      allow read: if true;
      // Auditoría 2026-09-16: cero validación de campos ni de autor -- cualquiera podía
      // crear una solicitud "de parte de" otro usuario, o inflar el documento hasta el
      // límite de 1MB de Firestore.
      allow create: if signedInReal() && autorEsUnoMismo() && strOk('to', 120) && strOk('status', 20);
      allow update: if signedIn();
      allow delete: if signedIn() && isOwnerOrLegacy();
    }

    // Diario personal (respaldo en la nube). Privacidad real: la migración a
    // auth.uid (v6.12) ya está lista para esto, pero nadie la había aplicado acá
    // — CUALQUIER usuario logueado podía leer, sobrescribir o borrar el diario de
    // OTRO usuario (reflexiones privadas), con el ID de documento predecible
    // (`{cu}_{fecha}`). OJO: isOwnerOrLegacy() NO sirve para esta colección — su
    // "grandfather" da por dueño a cualquiera cuando el documento no tiene el campo
    // `authUid`, y los diarios NUNCA lo tienen (usan `user`), así que habría quedado
    // siempre abierto. Se usa isOwnerByCu() solo, y en `create` se exige además que
    // el campo `user` sea tu propio uid (si no, alguien podría "adelantarse" y crear
    // el documento de otro usuario con contenido propio antes de que ese usuario
    // escriba el suyo).
    match /diarios/{id} {
      allow read: if signedIn() && isOwnerByCu();
      allow create: if signedInReal() && request.resource.data.user == request.auth.uid && strOk('reflexion', 2000) && strOk('complejo', 2000) && strOk('meta', 300);
      allow update: if signedIn() && isOwnerByCu() && strOk('reflexion', 2000) && strOk('complejo', 2000) && strOk('meta', 300);
      allow delete: if signedIn() && isOwnerByCu();
    }

    // Mensajes privados entre amigos. Auditoría 2026-08-30: el read solo exigía
    // signedIn() (incluida la sesión anónima con la que arranca la app) sin
    // verificar que fueras parte de la conversación — el conversationId es
    // predecible ([cu_a,cu_b].sort().join('__'), ver convIdDe() en index.html),
    // así que cualquiera que supiera los correos de dos personas podía leer
    // TODA su conversación llamando la API directo. Mismo patrón de bug ya
    // corregido antes en /diarios, replicado acá: exigir ser uno de los dos
    // participantes reales (uid de Firebase Auth, que es tu `cu` una vez que tu
    // sesión sube al token personalizado). Solo quien lo escribió puede
    // editarlo/borrarlo.
    match /dm/{conversationId}/messages/{msgId} {
      allow read: if signedIn() && conversationId.split('__').hasAny([request.auth.uid]);
      allow create: if signedInReal() && strOk('text', 1000) && autorEsUnoMismo();
      allow update, delete: if signedIn() && isOwnerOrLegacy();
    }

    // Te doy alojo (solo usuarios con 6+ meses, verificado en la app)
    match /alojo/{id} {
      allow read: if signedIn();
      allow create: if signedInReal() && strOk('desc', 600) && strOk('zona', 100) && autorEsUnoMismo();
      allow update, delete: if signedIn() && isOwnerOrLegacy();
    }

    // Votación de comunidad (un voto por usuario, id del doc = su propio usuario)
    match /votacionComunidad/{id} {
      allow read: if true;
      // Auditoría 2026-09-09: el doc id ES tu propio uid (db.collection('votacionComunidad').doc(cu),
      // ver gamificacion-comunidad.js) pero la regla no lo exigía -- cualquier signedIn() podía crear
      // docs con id inventado, y como el conteo es un count() sobre TODA la colección filtrando por
      // 'opcion', eso permitía inflar el resultado de la votación a mano (ballot stuffing).
      allow create, update: if signedInReal() && id == request.auth.uid && strOk('opcion', 40);
      allow delete: if signedIn() && id == request.auth.uid;
    }

    // Sorteo de comunidad (una participación por usuario; lista pública para transparencia)
    match /sorteoComunidad/{id} {
      allow read: if true;
      // Auditoría 2026-09-09: mismo patrón que /votacionComunidad -- el doc id ES tu propio
      // uid (db.collection('sorteoComunidad').doc(cu)) pero no se exigía, permitiendo anotarse
      // varias veces con ids inventados (inflar el conteo del sorteo).
      allow create: if signedInReal() && id == request.auth.uid && strOk('nombre', 60);
      allow update, delete: if signedIn() && id == request.auth.uid;
    }

    // Frases que aporta la comunidad para que Pistero las diga en la app. Quedan en
    // revisión (aprobada:false) hasta que el ADMIN (de verdad, ver isAdmin) las
    // aprueba/rechaza — antes cualquier signedIn() podía auto-aprobarse o borrar
    // frases ajenas llamando la API directo, aunque la UI lo ocultara.
    match /frasesComunidad/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('texto', 140) && strOk('nombre', 60) && autorEsUnoMismo();
      allow update, delete: if isAdmin();
    }

    // Novedades del mundo del ciclismo en Chile (competencias, rodadas, cicloturismo).
    // Las publica el ADMIN (de verdad, ver isAdmin) desde el panel de Perfil; antes
    // cualquier signedIn() podía publicar "Novedades" falsas llamando la API directo.
    match /novedades/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && strOk('titulo', 120) && strOk('desc', 800) && strOk('categoria', 30) && strOk('link', 300) && strOk('fecha', 60);
      allow delete: if isAdmin();
    }

    // Seguimiento en vivo: comparte tu ubicación con un link (quien lo abre no
    // necesita cuenta ni la app instalada) -- seguir.html lee el documento por su
    // id exacto (un get, nunca una query), así que "quien tiene el link, ve" solo
    // necesita permitir GET. Antes esto era "allow read: if true", que en las
    // reglas de Firestore cubre TANTO get como list -- cualquiera, sin tener
    // ningún link, podía hacer where('activo','==',true) y listar en tiempo real
    // la posición y nombre de TODA persona compartiendo ubicación en cualquier
    // parte del mundo, sin haber recibido el link de nadie (hallazgo real,
    // 2026-09-03, confirmado leyendo el código: motor-navegacion.js hacía
    // exactamente esa query sin ningún filtro). "list: false" cierra ese hueco sin
    // tocar el caso de uso real del link -- get sigue público a propósito.
    // (El worker-proximidad que reemplaza la alerta "ciclista adelante" sobre esta
    // misma base -- ver tarea #195 del hub -- ya está construido y en main, solo
    // falta desplegarlo con un token de Cloudflare con más permiso.)
    // Auditoría 2026-09-16: create/update solo exigían estar logueado -- sin
    // verificar dueño, cualquier usuario real podía escribir lat/lon en el
    // liveTracking de OTRO ciclista (falsificar la ubicación que ven sus contactos de
    // confianza) o borrar su seguimiento (`delete: if signedIn()`, sin dueño tampoco).
    // authUid ahora se escribe siempre desde el cliente (ver seguridad-sensores.js) --
    // se exige en el create y se verifica en update/delete contra el documento ya
    // guardado.
    match /liveTracking/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if signedInReal() && strOk('nombre', 60) && request.resource.data.authUid == request.auth.uid;
      allow update: if signedIn() && strOk('nombre', 60)
        && (!('authUid' in resource.data) || resource.data.authUid == request.auth.uid);
      allow delete: if signedIn() && (!('authUid' in resource.data) || resource.data.authUid == request.auth.uid);
    }

    // Segmentos (tramos para competir por mejor tiempo, estilo Strava) y sus marcas.
    match /segmentos/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('nombre', 80) && strOk('desc', 300) && autorEsUnoMismo();
      // Auditoría 2026-09-09: no había NINGÚN chequeo de dueño en update/delete (ni siquiera
      // isOwnerOrLegacy, que acá no aplica -- el campo se llama `creadoPor`, no `user`/`authUid`)
      // -- cualquier signedIn() podía editar o borrar el segmento de otro llamando la API directo.
      // Grandfather igual que isOwnerOrLegacy: si un segmento viejo no tiene `creadoPor`, no se
      // bloquea a nadie (no hay forma de saber quién era el dueño real).
      allow update, delete: if signedIn()
        && (!('creadoPor' in resource.data) || resource.data.creadoPor == request.auth.uid);
    }
    match /segmentoTiempos/{id} {
      allow read: if true;
      // Auditoría 2026-09-16: tiempoMs sin validar -- un valor negativo o cero encabeza
      // cualquier tabla de líderes sin haber pedaleado. Tope de 24h, generoso.
      allow create: if signedInReal() && strOk('nombre', 60) && strOk('segmentoId', 100)
        && autorEsUnoMismo() && numOk('tiempoMs', 1, 86400000);
      allow update, delete: if signedIn() && isOwnerOrLegacy();
    }

    // Retos y temporadas (desafíos con fecha límite sobre el Darma existente).
    // Los publica el ADMIN (de verdad, ver isAdmin) desde Ajustes; antes cualquier
    // signedIn() podía crear/editar retos falsos llamando la API directo.
    match /retos/{id} {
      allow read: if true;
      allow create: if isAdmin() && strOk('titulo', 100) && strOk('desc', 400);
      allow update, delete: if isAdmin();
    }

    // Rodadas grupales (salidas con fecha/hora/punto de encuentro). update queda
    // abierto a signedIn(): es como CUALQUIER asistente marca "voy"/"no voy" (lista
    // de asistentes), no solo quien la creó. delete sí se restringe al creador.
    match /rodadas/{id} {
      allow read: if true;
      allow create: if signedInReal() && strOk('titulo', 100) && strOk('puntoEncuentro', 150) && strOk('desc', 400) && autorEsUnoMismo();
      allow update: if signedIn() && strOk('titulo', 100) && strOk('puntoEncuentro', 150) && strOk('desc', 400);
      allow delete: if signedIn() && isOwnerOrLegacy();
    }

    // Alertas SOS de la comunidad: ANONIMAS y de ubicacion GRUESA (~5km, sin identidad ni
    // ubicacion exacta). Cualquiera autenticado puede pedir ayuda (create) y recibir (read);
    // el dato ya es seguro por diseno. Inmutable: sin update/delete.
    match /sosAlertas/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && strOk("comuna", 80);
      allow update, delete: if false;
    }

    // Reseñas de la app (estrellas + comentario). Sin esta regla el catch-all de abajo
    // denegaba la escritura y el boton "Enviar" fallaba SIEMPRE en silencio.
    //  - read solo admin: es feedback privado, no contenido de comunidad. Con read:true
    //    cualquiera podria listar lo que opinaron todos los demas junto a su nombre y su
    //    `user` (el correo transformado) — un volcado de la base de usuarios de regalo.
    //    Inty las lee desde la consola de Firebase.
    //  - create de cualquiera autenticado, con el comentario acotado y la nota validada
    //    de 1 a 5 (si no, se puede inyectar una nota de 10.000 y ensuciar el promedio).
    //  - inmutable: nadie edita ni borra una reseña ya enviada, ni la propia.
    match /resenasApp/{id} {
      allow read: if signedIn() && isAdmin();
      allow create: if signedInReal()
        && strOk('comentario', 500) && strOk('nombre', 80)
        && request.resource.data.estrellas is number
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5;
      allow update, delete: if false;
    }

    // Mapa propio de direcciones (2026-08-29): caché comunitaria de direcciones ya
    // confirmadas por un ciclista real (geocode exacto, aproximado aceptado a sabiendas,
    // o marcado a mano en el mapa) — Nominatim/OSM casi no tiene números de casa en
    // Chile fuera del centro de Santiago, y esto evita repetir la misma búsqueda fallida.
    // id del doc = clave normalizada de la dirección (ver _keyDireccion en index.html),
    // así que create Y update válidos son la MISMA operación (set con merge:true) —
    // cualquiera puede reafirmar/mejorar una entrada ya existente, no solo crearla.
    // Lectura pública a propósito: el punto de esto es que TODOS se beneficien, incluso
    // antes de loguearse. Inmutable a delete: si una entrada queda mal, se sobreescribe
    // con una mejor, no se borra (evita vandalismo silencioso).
    match /direccionesGeo/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && strOk('q', 200) && strOk('name', 300) && strOk('origen', 40) && strOk('creadoPor', 120)
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon >= -180 && request.resource.data.lon <= 180;
      allow delete: if false;
    }

    // Todo lo demás: denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
